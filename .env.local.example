# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — real keys must never be committed.

# ---- Supabase (Project Settings → API) ----
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by scripts/seed-supabase.mjs and Edge Functions.
# Never prefix this with NEXT_PUBLIC and never reference it in app/ or components/.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (added when we wire real payments) ----
# Key id is public; the secret lives only in a Supabase Edge Function.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
